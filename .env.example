# Copy to .env on the host and fill in. Never commit the real .env.
SECRET_KEY=make-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=clptrack.onrender.com
CSRF_TRUSTED_ORIGINS=https://clptrack.onrender.com
DAILY_TASK_TOKEN=another-long-random-string
DATABASE_URL=postgres://user:password@host:5432/clptrack
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=CLPTrack <no-reply@example.com>
